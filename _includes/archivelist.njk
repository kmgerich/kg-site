{#- Year-headed index for the old archive (inspired by hicks.design/journal/archive):
    a year heading followed by a dense "date  title" list, newest first. #}
{%- set yearGroups = postslist | reverse | groupByYear %}
{%- for group in yearGroups %}
<h2 class="archive-year">{{ group.year }}</h2>
<ul class="archive-list">
	{%- for post in group.posts %}
	<li class="archive-list-item">
		<time datetime="{{ post.date | htmlDateString }}">{{ post.date | readableDate("MM-dd") }}</time>
		<a href="{{ post.url }}">{% if post.data.title %}{{ post.data.title }}{% else %}<code>{{ post.url }}</code>{% endif %}</a>
	</li>
	{%- endfor %}
</ul>
{%- endfor %}
