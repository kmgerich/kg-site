---
layout: layouts/base.njk
---
{# Only include the syntax highlighter CSS on posts with code, included with the CSS per-page bundle #}
{%- css %}{% include "node_modules/prismjs/themes/prism-okaidia.css" %}{% endcss %}
{%- css %}{% include "public/css/prism-diff.css" %}{%- endcss %}

<article class="archive-post">
	<p class="archive-post-banner">From the archive — originally published {{ page.date | readableDate }} on the old Firefox/Pinstripe-era blog.</p>

	<header class="essay-header">
		<h1>{{ title }}</h1>
		<ul class="post-metadata">
			<li><time datetime="{{ page.date | htmlDateString }}">{{ page.date | readableDate }}</time></li>
			{%- for tag in tags | filterTagList %}
			{%- set tagUrl %}/tags/{{ tag | slugify }}/{% endset %}
			<li><a href="{{ tagUrl }}" class="post-tag">{{ tag }}</a>{%- if not loop.last %}, {% endif %}</li>
			{%- endfor %}
		</ul>
	</header>

	<div class="essay-content">
		{{ content | safe }}
	</div>
</article>

{%- if collections.archive %}
{%- set previousPost = collections.archive | getPreviousCollectionItem %}
{%- set nextPost = collections.archive | getNextCollectionItem %}
{%- if nextPost or previousPost %}
<ul class="links-nextprev">
	{%- if previousPost %}<li class="links-nextprev-prev">← Previous<br> <a href="{{ previousPost.url }}">{{ previousPost.data.title }}</a></li>{% endif %}
	{%- if nextPost %}<li class="links-nextprev-next">Next →<br><a href="{{ nextPost.url }}">{{ nextPost.data.title }}</a></li>{% endif %}
</ul>
{%- endif %}
{%- endif %}
